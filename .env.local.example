# Copy this file to `.env.local` and fill in real values.
# `.env.local` is gitignored and must NEVER be committed.
#
# Only variables prefixed with NEXT_PUBLIC_ are exposed to the browser — keep
# true secrets unprefixed and server-side only.

# Public site URL (used for metadata / canonical links in a later phase)
# NEXT_PUBLIC_SITE_URL=https://hussain.example

# --- EmailJS (contact form) --------------------------------------------------
# Get these from the EmailJS dashboard (https://dashboard.emailjs.com):
#   • Service ID  → Email Services  (the service you connected, e.g. Gmail)
#   • Template ID → Email Templates (create one; its variables must match the
#                    params sent in Contact.tsx: from_name, from_email,
#                    reply_to, message)
#   • Public Key  → Account → General → Public Key
# The public key is designed by EmailJS to be safe for client-side exposure,
# so NEXT_PUBLIC_ is correct here. Restrict allowed origins in the EmailJS
# dashboard (Account → Security) to your production domain to limit abuse.
NEXT_PUBLIC_EMAILJS_SERVICE_ID=your_service_id
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=your_template_id
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your_public_key
